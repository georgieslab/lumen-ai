PORT=3000
NODE_ENV=development

# Amazon Bedrock & Polly Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Model used when Lumen writes a web page, game or demo (defaults to Claude Sonnet 4.5 in the EU).
# Use a model your AWS account can invoke, or "none" to always use the everyday model.
LUMEN_PAGE_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
POLLY_REGION=eu-west-1
POLLY_VOICE_ID=Matthew

# Direct OpenAI API Fallback Key
OPENAI_API_KEY=your_openai_api_key
VITE_OPENAI_API_KEY=your_openai_api_key

# GitHub OAuth App (server-side only)
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
LUMEN_APP_URL=http://localhost:5173

# Cloud profile and memory storage
LUMEN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
LUMEN_MEMORY_TABLE_NAME=lumen-user-memory
LUMEN_ALLOWED_ORIGINS=http://localhost:5173
# Set true only when the frontend and API are on different sites, not merely different ports.
LUMEN_CROSS_SITE_COOKIES=false

# Hourly limits per visitor (signed-in user, else IP address). Defaults shown.
LUMEN_RESEARCH_PER_HOUR=12
LUMEN_PLANS_PER_HOUR=40
LUMEN_BROWSE_PER_HOUR=60
